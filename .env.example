# =====================================================
# ResumePilot AI - Environment Configuration
# =====================================================
# Copy this file to .env and fill in your real values.
# IMPORTANT: Do not commit .env to GitHub!

# Google Gemini AI API Configuration
# Get your free API key at: https://aistudio.google.com
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# Optional: Alternative API key names (Streamlit Cloud compatible)
# Uncomment one of these if you prefer different variable naming
# GOOGLE_API_KEY=your_google_ai_studio_api_key_here
# GOOGLE_GENERATIVE_AI_API_KEY=your_google_ai_studio_api_key_here

# Streamlit Configuration (optional)
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=false

# Application Settings
APP_ENVIRONMENT=development
# Options: development, production, testing

